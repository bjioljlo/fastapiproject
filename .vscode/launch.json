{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debug (main.py as module)",
            "type": "debugpy",
            "request": "launch",
            "module": "fast_api_project.main",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "justMyCode": true
        },
        {
            "name": "FastAPI Debug (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "fast_api_project.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "justMyCode": true
        }
    ]
}