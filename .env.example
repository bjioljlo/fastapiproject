# =============================================================================
# Environment Variables for FastAPI Project
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# =============================================================================
#
# NOTE: .env is in .gitignore and should NEVER be committed to version control.
#       Only .env.example is tracked.
# =============================================================================

# --- Database Settings (DATABASE_*) ---
# MySQL connection string: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/fastapi

# --- Application Settings (APP_*) ---
APP_TITLE=OH~MY~~API
APP_VERSION=1.0.0
APP_DEBUG=false

# --- Server Settings (SERVER_*) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Security Settings (SECURITY_*) ---
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY_SECRET_KEY=
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30